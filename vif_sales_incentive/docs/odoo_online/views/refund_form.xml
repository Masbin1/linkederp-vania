<form string="Refund Invoice">
    <group>
        <group>
            <field name="x_move_id" readonly="1"/>
            <field name="x_employee_id" readonly="1"/>
            <field name="x_move_line_id" readonly="1" options="{'no_create': True}"/>
        </group>
        <group>
            <field name="x_base_amount" readonly="1"/>
            <field name="x_refundable_amount" readonly="1"/>
            <field name="x_refund_amount"/>
            <field name="x_currency_id" invisible="1"/>
        </group>
    </group>
    <footer>
        <button name="[ID VIF: Refund Confirm]" type="action"
                string="Create Credit Note &amp; Refund" class="btn-primary"/>
        <button string="Cancel" class="btn-secondary" special="cancel"/>
    </footer>
</form>
