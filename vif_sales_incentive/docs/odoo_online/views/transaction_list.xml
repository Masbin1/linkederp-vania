<list string="Incentive Transactions" create="0">
    <field name="x_name"/>
    <field name="x_employee_id"/>
    <field name="x_project_id" optional="show"/>
    <field name="x_split_role" optional="show"/>
    <field name="x_split_share" optional="show" widget="percentage"/>
    <field name="x_source_type" optional="hide"/>
    <field name="x_source_period_id"/>
    <field name="x_payment_period_id"/>
    <field name="x_transaction_type"/>
    <field name="x_base_amount" sum="Total"/>
    <field name="x_discount" optional="hide"/>
    <field name="x_is_discount_eligible"/>
    <field name="x_is_payment_eligible"/>
    <field name="x_is_downpayment" optional="hide"/>
    <field name="x_bucket" optional="hide"/>
    <field name="x_tier_payout_rate" optional="hide"/>
    <field name="x_payout_amount" sum="Total"/>
    <field name="x_state" widget="badge"/>
    <field name="x_currency_id" column_invisible="1"/>
</list>
