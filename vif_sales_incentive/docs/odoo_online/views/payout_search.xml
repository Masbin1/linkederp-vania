<search string="Incentive Payouts">
    <field name="x_employee_id"/>
    <field name="x_period_id"/>
    <field name="x_branch_id"/>
    <filter name="f_eligible" string="Eligible Month" domain="[('x_is_eligible', '=', True)]"/>
    <filter name="f_frozen" string="Frozen" domain="[('x_is_frozen', '=', True)]"/>
    <group>
        <filter name="g_period" string="Period" context="{'group_by': 'x_period_id'}"/>
        <filter name="g_branch" string="Branch" context="{'group_by': 'x_branch_id'}"/>
        <filter name="g_btype" string="Business Type" context="{'group_by': 'x_business_type'}"/>
    </group>
</search>
