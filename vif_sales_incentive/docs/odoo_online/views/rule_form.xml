<form string="Incentive Rule">
    <sheet>
        <div class="oe_title"><h1><field name="x_name"/></h1></div>
        <group>
            <group>
                <field name="x_date_from"/>
                <field name="x_date_to"/>
                <field name="x_company_id"/>
                <field name="x_active"/>
            </group>
            <group>
                <field name="x_base_rate"/>
                <field name="x_bonus_rate"/>
                <field name="x_max_discount"/>
                <field name="x_cap_tier_in_mixed"/>
                <field name="x_mixed_cap_tier_level"/>
            </group>
        </group>
        <field name="x_tier_ids">
            <list editable="bottom">
                <field name="x_level"/>
                <field name="x_name"/>
                <field name="x_achievement_min"/>
                <field name="x_achievement_max"/>
                <field name="x_is_top_tier"/>
                <field name="x_allocation"/>
                <field name="x_payout_rate"/>
            </list>
        </field>
    </sheet>
</form>
