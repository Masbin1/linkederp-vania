<form>
    <header>
        <button name="[ID VIF: Transaction Refund]" type="action"
                string="Create Credit Note / Refund" class="btn-warning"
                invisible="x_state == 'reversed'"/>
        <field name="x_state" widget="statusbar"/>
    </header>
    <sheet>
        <div class="oe_title"><h1><field name="x_display_ref" readonly="1"/></h1></div>
        <group>
            <group string="Source">
                <field name="x_source_type"/>
                <field name="x_move_id" invisible="x_source_type == 'pos'"/>
                <field name="x_move_line_id" invisible="x_source_type == 'pos'"/>
                <field name="x_pos_order_id" invisible="x_source_type != 'pos'"/>
                <field name="x_pos_order_line_id" invisible="x_source_type != 'pos'"/>
                <field name="x_employee_id"/>
                <field name="x_project_id" invisible="not x_project_id"/>
                <field name="x_split_role"/>
                <field name="x_split_share" widget="percentage"/>
                <field name="x_partner_id"/>
                <field name="x_transaction_type"/>
            </group>
            <group string="Period Stamps">
                <field name="x_invoice_date"/>
                <field name="x_source_period_id"/>
                <field name="x_payment_date"/>
                <field name="x_payment_period_id"/>
                <field name="x_is_prior_period"/>
            </group>
        </group>
        <group>
            <group string="Eligibility">
                <field name="x_discount"/>
                <field name="x_is_downpayment"/>
                <field name="x_is_discount_eligible"/>
                <field name="x_is_payment_eligible"/>
                <field name="x_bucket"/>
                <field name="x_incentive_alloc"/>
                <field name="x_bonus_alloc"/>
                <field name="x_eligibility_note"/>
            </group>
            <group string="Payout (frozen snapshot)">
                <field name="x_base_amount"/>
                <field name="x_tier_id"/>
                <field name="x_tier_payout_rate" digits="[16,6]"/>
                <field name="x_payout_amount"/>
                <field name="x_currency_id" invisible="1"/>
            </group>
        </group>
        <group string="Adjustment Trail">
            <field name="x_reversal_of_id"/>
            <field name="x_reversal_ids" readonly="1"/>
        </group>
    </sheet>
</form>
