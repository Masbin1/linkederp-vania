<search string="Incentive Transactions">
    <field name="x_employee_id"/>
    <field name="x_move_id"/>
    <field name="x_project_id"/>
    <field name="x_source_period_id"/>
    <field name="x_payment_period_id"/>
    <filter name="f_invoice" string="From Invoice" domain="[('x_source_type', '=', 'invoice')]"/>
    <filter name="f_pos" string="From POS" domain="[('x_source_type', '=', 'pos')]"/>
    <separator/>
    <filter name="f_paid" string="Fully Paid" domain="[('x_is_payment_eligible', '=', True)]"/>
    <filter name="f_unpaid" string="Not Fully Paid" domain="[('x_is_payment_eligible', '=', False)]"/>
    <separator/>
    <filter name="f_excluded" string="Excluded (discount &gt; cap)"
            domain="[('x_is_discount_eligible', '=', False)]"/>
    <filter name="f_prior" string="Prior-Period Invoice" domain="[('x_is_prior_period', '=', True)]"/>
    <filter name="f_refund" string="Refunds" domain="[('x_transaction_type', '=', 'refund')]"/>
    <group>
        <filter name="g_employee" string="Employee" context="{'group_by': 'x_employee_id'}"/>
        <filter name="g_project" string="Project" context="{'group_by': 'x_project_id'}"/>
        <filter name="g_source" string="Source Type" context="{'group_by': 'x_source_type'}"/>
        <filter name="g_source_period" string="Source Period" context="{'group_by': 'x_source_period_id'}"/>
    </group>
</search>
