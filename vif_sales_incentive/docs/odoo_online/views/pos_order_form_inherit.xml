<!-- Inherited view: Model = Point of Sale Orders (pos.order),
     Inherited View = point_of_sale.view_pos_pos_form ("pos.order.form") -->
<data>
    <xpath expr="//field[@name='employee_id']" position="after">
        <field name="x_incentive_transaction_ids" readonly="1"
               invisible="not x_incentive_transaction_ids">
            <list>
                <field name="x_source_period_id"/>
                <field name="x_base_amount"/>
                <field name="x_is_payment_eligible"/>
                <field name="x_state"/>
            </list>
        </field>
    </xpath>
</data>
