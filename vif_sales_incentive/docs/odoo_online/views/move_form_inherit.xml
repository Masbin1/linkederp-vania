<!-- Inherited view: Model = Journal Entry (account.move),
     Inherited View = account.view_move_form ("account.move.form") -->
<data>
    <xpath expr="//field[@name='invoice_user_id']" position="after">
        <field name="x_incentive_employee_id"
               invisible="move_type not in ('out_invoice', 'out_refund')"/>
        <field name="x_incentive_full_payment_date" readonly="1"
               invisible="move_type not in ('out_invoice', 'out_refund')"/>
    </xpath>
    <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']"
           position="after">
        <field name="x_incentive_eligible" optional="show" readonly="1"
               string="Inc. Eligible"/>
    </xpath>
</data>
